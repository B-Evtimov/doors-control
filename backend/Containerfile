# Public API. Runs as an unprivileged user inside a rootless Podman container.
FROM docker.io/library/python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --gid 10001 acs && \
    useradd --uid 10001 --gid acs --no-create-home --shell /usr/sbin/nologin acs

WORKDIR /srv/acs

COPY pyproject.toml ./
COPY app ./app
COPY signer ./signer
COPY admin ./admin

RUN pip install --no-cache-dir . && \
    find /srv/acs -name '__pycache__' -type d -prune -exec rm -rf {} +

USER acs:acs

EXPOSE 8080

# No secrets baked in; everything comes from the environment at run time.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8080", \
     "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1", \
     "--no-server-header", "--log-level", "info"]
