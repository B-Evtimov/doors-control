# ============================================================================
#  Evtimov Doors Control System - environment template
#
#  Copy to .env and fill in. Every value is empty on purpose: this file is
#  committed, .env never is. Nothing in this repository reads a secret from
#  anywhere except the process environment.
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# "production" or "development". Development relaxes nothing security related;
# it only enables verbose logging and the OpenAPI schema endpoint.
ACS_ENV=
# Address the public API binds to inside its container. Keep 0.0.0.0 only
# because the container itself is published to 127.0.0.1 by the unit file.
ACS_API_HOST=
ACS_API_PORT=
# Comma-separated list of trusted proxy IPs allowed to set X-Forwarded-For.
# Anything else and the client IP used for rate limiting is the socket peer.
ACS_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Database - one DSN per role. The application never connects as a superuser
# and never as the migration role.
# ---------------------------------------------------------------------------
# Used by the API for all operational tables. Has no UPDATE/DELETE on audit_log.
ACS_DB_DSN=
# Used only by the audit writer / admin reader. INSERT and SELECT on audit_log.
ACS_AUDIT_DB_DSN=
# Used only by db/apply.sh. Owns the schema, allowed to run DDL.
ACS_MIGRATE_DB_DSN=
ACS_DB_POOL_MIN=
ACS_DB_POOL_MAX=
# Seconds. A statement that runs longer is cancelled by the server.
ACS_DB_STATEMENT_TIMEOUT=

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# Lifetime of an opaque access token, in seconds. 900 = 15 minutes.
ACS_ACCESS_TOKEN_TTL=
# Lifetime of an opaque refresh token, in seconds. 2592000 = 30 days.
ACS_REFRESH_TOKEN_TTL=
# Pepper mixed into the SHA-256 of every token before it is stored. Rotating
# it invalidates every live session. 32 random bytes, base64.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ACS_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Password hashing (Argon2id)
# ---------------------------------------------------------------------------
ACS_ARGON2_TIME_COST=
ACS_ARGON2_MEMORY_KIB=
ACS_ARGON2_PARALLELISM=

# ---------------------------------------------------------------------------
# Login hardening
# ---------------------------------------------------------------------------
# Every authentication response is padded to this many milliseconds so that a
# wrong username and a wrong password are indistinguishable by timing.
ACS_AUTH_FIXED_RESPONSE_MS=
# Failures inside the window that trigger progressive delay / lockout.
ACS_RATE_WINDOW_SECONDS=
ACS_RATE_MAX_LOGIN_FAILURES=
ACS_RATE_MAX_UNLOCKS_PER_MINUTE=
ACS_RATE_BASE_DELAY_MS=
ACS_RATE_MAX_DELAY_MS=

# ---------------------------------------------------------------------------
# Proximity (BLE beacon)
# ---------------------------------------------------------------------------
# How long a rotating beacon identifier stays valid, in seconds.
ACS_BEACON_ROTATION_SECONDS=
# How old an observation may be and still be accepted, in seconds.
ACS_PROXIMITY_MAX_AGE_SECONDS=

# ---------------------------------------------------------------------------
# Command signer - separate process, separate container, no network.
# ---------------------------------------------------------------------------
# Unix socket the API uses to reach the signer. Shared volume, mode 0660.
ACS_SIGNER_SOCKET=
ACS_SIGNER_TIMEOUT_MS=
# Read only by the signer container. Ed25519 private key, 32 bytes, base64.
#   python -m backend.signer.keygen
ACS_SIGNER_PRIVATE_KEY=
# Read by the API and shipped to controllers at provisioning time.
ACS_SIGNER_PUBLIC_KEY=
# Identifier written into every signed command so keys can be rotated.
ACS_SIGNER_KEY_ID=

# ---------------------------------------------------------------------------
# Controller WebSocket
# ---------------------------------------------------------------------------
ACS_WS_HEARTBEAT_SECONDS=
ACS_WS_HEARTBEAT_TIMEOUT_SECONDS=
# How long a controller has to answer the Ed25519 challenge, in seconds.
ACS_WS_HANDSHAKE_TIMEOUT_SECONDS=
# How long a signed unlock command stays valid, in seconds. Keep it short.
ACS_COMMAND_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Device attestation
# ---------------------------------------------------------------------------
# "strict" rejects any device whose attestation does not verify.
# "log_only" records the verdict but still enrolls - development only.
ACS_ATTESTATION_MODE=
# Google Play Integrity service account JSON, base64 encoded.
ACS_PLAY_INTEGRITY_CREDENTIALS=
ACS_PLAY_INTEGRITY_PACKAGE_NAME=
# SHA-256 of the release signing certificate, hex, no separators.
ACS_ANDROID_CERT_DIGEST=
# Root certificates accepted for hardware key attestation chains, PEM path.
ACS_ATTESTATION_ROOTS_PEM=

# ---------------------------------------------------------------------------
# Admin application - separate ASGI app, separate container.
# ---------------------------------------------------------------------------
# Never set this to 0.0.0.0. See docs/03-deployment.md.
ACS_ADMIN_HOST=
ACS_ADMIN_PORT=
# Comma-separated CIDRs allowed to reach the admin app at all.
ACS_ADMIN_ALLOWED_CIDRS=
